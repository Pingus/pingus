;; Animations of the pingus of player 1, requested by the pingu actions
(pingus-animset
  (animations
    (angel (sprite "pingus/player1/angel"))
    (basher (left "pingus/player1/basher/left") (right "pingus/player1/basher/right"))
    (blocker (left "pingus/player1/blocker/left") (right "pingus/player1/blocker/right"))
    (boarder (left "pingus/player1/boarder/left") (right "pingus/player1/boarder/right"))
    (bomber (left "pingus/player1/bomber/left") (right "pingus/player1/bomber/right"))
    (bridger (left "pingus/player1/bridger/left") (right "pingus/player1/bridger/right"))
    (bridger-walk (left "pingus/player1/bridger_walk/left") (right "pingus/player1/bridger_walk/right"))
    (climber (left "pingus/player1/climber/left") (right "pingus/player1/climber/right"))
    (digger (sprite "pingus/player1/digger/left"))
    (drown (left "pingus/player1/drownfall/left") (right "pingus/player1/drownfall/right"))
    (exit (left "pingus/player1/exit/left") (right "pingus/player1/exit/right"))
    (faller (left "pingus/player1/faller/left") (right "pingus/player1/faller/right"))
    (tumbler (left "pingus/player1/tumbler/left") (right "pingus/player1/tumbler/right"))
    (floater (sprite "pingus/player1/floater/left"))
    (jumper (left "pingus/player1/jumper/left") (right "pingus/player1/jumper/right"))
    (laserkill (left "other/laser_kill/left") (right "other/laser_kill/right") (offset 0 2))
    (miner (left "pingus/player1/miner/left") (right "pingus/player1/miner/right"))
    (slider (left "pingus/player1/slider/left") (right "pingus/player1/slider/right") (offset 0 -2))
    ;; FIXME: this is the whole bomber sprite sheet as one image, the
    ;; smashed action is currently unused
    (smashed (sprite "pingus/player1/bomber"))
    (splashed (sprite "pingus/player1/splat"))
    (superman (sprite "pingus/player1/superman"))
    (waiter (sprite "pingus/player1/waiter/left"))
    (walker (left "pingus/player1/walker/left") (right "pingus/player1/walker/right"))
    (floater-layer (left "other/floaterlayer/left") (right "other/floaterlayer/right"))
    (explosion (sprite "pingus/player1/explo"))))
