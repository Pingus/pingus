;; Animations of the pingus of player 2, requested by the pingu actions
(pingus-animset
  (animations
    (angel (frames (image "images/pingus/player2/angel.png") (speed 100) (loop #t) (array 4 1) (size 46 30)))
    (basher (frames (image "images/pingus/player2/basher.png") (offset 0 1) (origin "bottom_center") (speed 100) (loop #t) (array 12 1) (size 32 32))
            (right-frames (position 0 32)))
    (blocker (frames (image "images/pingus/player2/blocker.png") (offset 0 2) (origin "bottom_center") (speed 100) (loop #t) (array 6 1) (size 32 32)))
    (boarder (frames (image "images/pingus/player2/boarder.png") (size 30 30))
             (right-frames (position 0 30)))
    (bomber (frames (image "images/pingus/player2/bomber.png") (offset 0 2) (origin "bottom_center") (speed 60) (loop #f) (array 16 1) (size 32 32))
            (effects
              (sound (at-step 0) (name "ohno") (volume 0.5))
              (sound (at-step 10) (name "plop") (volume 0.5))
              (particles (at-step 13) (kind "pingu") (offset 0 -5))
              (overlay (at-step 13) (animation "explosion") (offset -32 -48))))
    (bridger (frames (image "images/pingus/player2/bridger.png") (offset 0 2) (origin "bottom_center") (speed 66) (loop #f) (array 15 1) (size 32 32))
             (right-frames (position 0 32)))
    (bridger-walk (frames (image "images/pingus/player2/bridger_walk.png") (offset 0 2) (origin "bottom_center") (speed 66) (loop #f) (array 4 1) (size 32 32))
                  (right-frames (position 0 32)))
    (climber (frames (image "images/pingus/player2/climber.png") (origin "bottom_center") (speed 100) (loop #t) (array 8 1) (size 32 32))
             (left-frames (offset 16 2))
             (right-frames (offset -14 2) (position 0 32)))
    (digger (frames (image "images/pingus/player2/digger.png") (offset 0 2) (origin "bottom_center") (speed 100) (loop #t) (array 14 1) (size 32 32)))
    (drown (frames (image "images/pingus/player2/drownfall.png") (offset 0 2) (origin "bottom_center") (speed 60) (loop #f) (array 15 1) (size 32 32))
           (right-frames (position 0 32)))
    (exit (frames (image "images/pingus/player2/exit.png") (origin "bottom_center") (speed 60) (loop #f) (array 9 1) (size 32 32))
          (left-frames (offset -2 2))
          (right-frames (offset 0 2) (position 0 32))
          (effects
            (sound (at-step 0) (name "yipee"))))
    (faller (frames (image "images/pingus/player2/faller.png") (offset 0 2) (origin "bottom_center") (speed 100) (loop #t) (array 8 1) (size 32 32)))
    (tumbler (frames (image "images/pingus/player2/tumble.png") (offset 0 2) (origin "bottom_center") (speed 100) (loop #t) (array 8 1) (size 32 32)))
    (floater (frames (image "images/pingus/player2/floater.png") (offset 0 2) (origin "bottom_center") (speed 100) (loop #t) (array 8 1) (size 32 32)))
    (jumper (frames (image "images/pingus/player2/faller.png") (offset 0 2) (origin "bottom_center") (speed 100) (loop #t) (array 8 1) (size 32 32)))
    (laserkill (left "other/laser_kill/left") (right "other/laser_kill/right") (offset 0 2))
    (miner (frames (image "images/pingus/player2/miner.png") (offset 0 2) (origin "bottom_center") (speed 100) (loop #t) (array 12 1) (size 32 32))
           (right-frames (position 0 32)))
    (slider (frames (image "images/pingus/player2/slider.png") (offset 0 2) (origin "bottom_center") (size 32 15))
            (right-frames (position 0 15))
            (offset 0 -2))
    ;; FIXME: this is the whole bomber sprite sheet as one image, the
    ;; smashed action is currently unused
    (smashed (sprite "pingus/player2/bomber"))
    (splashed (frames (image "images/pingus/player2/splat.png") (offset 0 2) (origin "bottom_center") (speed 33) (loop #f) (array 16 1) (size 32 32))
              (effects
                (sound (at-step 0) (name "splash") (volume 0.5))))
    (superman (frames (image "images/pingus/player2/superman.png") (speed 100) (loop #t) (array 8 1) (size 30 30)))
    (waiter (frames (image "images/pingus/player2/waiter.png") (offset 0 2) (origin "bottom_center") (speed 100) (loop #t) (array 6 1) (size 32 32)))
    (walker (frames (image "images/pingus/player2/walker.png") (offset 0 2) (origin "bottom_center") (speed 60) (loop #t) (array 8 1) (size 32 32))
            (right-frames (position 0 32)))
    (floater-layer (left "other/floaterlayer/left") (right "other/floaterlayer/right"))
    (explosion (sprite "pingus/player2/explo"))))
